# ======================================================================
# PAWPAL WEBSITE ENVIRONMENT TEMPLATE
# ======================================================================
# NEVER COMMIT REAL VALUES. Copy this file to `.env.local` for local work.
# Stripe values in this template must stay test-mode only. Do not place
# production-mode Stripe keys in this file.
#
# Variables prefixed with NEXT_PUBLIC_ are bundled for browser use.
# Server-only secrets must never be renamed with a NEXT_PUBLIC_ prefix.

# ----------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------
# Source: Supabase Dashboard > Project Settings > API. Public: yes. Required: yes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Source: Supabase Dashboard > Project Settings > API anon/publishable key. Public: yes. Required: yes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Source: Supabase Dashboard > Project Settings > API service role key. Public: no, server-only. Required: yes for admin/report APIs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------------------
# Cyber companion: calls the authenticated Supabase `companion-chat` Edge function.
# Configure QWEN_API_KEY / QWEN_BASE_URL / QWEN_MODEL only in that Edge service
# (see PawPal/supabase/functions/companion.env.example). Never add a browser Qwen key.
# AI, Places, and Maps
# ----------------------------------------------------------------------
# Source: Google AI Studio Gemini API key. Public: no, server-only. Required: yes for AI API routes.
GEMINI_API_KEY=your-gemini-api-key

# Source: Google Cloud Console Places API key. Public: no, server-only. Required: yes for map-search API routes.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Source: Google Cloud Console browser-restricted Maps key. Public: yes. Required: yes for client map features that need Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-browser-restricted-google-maps-key

# ----------------------------------------------------------------------
# Stripe - TEST MODE ONLY
# ----------------------------------------------------------------------
# Source: Stripe Dashboard test mode > Developers > API keys. Public: no, server-only. Required: yes for checkout APIs.
STRIPE_SECRET_KEY=sk_test_replace_me

# Source: Stripe Dashboard test mode > Developers > Webhooks endpoint secret. Public: no, server-only. Required: yes for webhook verification.
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me

# Source: Stripe Dashboard test mode > Products > Basic monthly price ID. Public: no, server-only. Required: yes for Basic checkout.
STRIPE_BASIC_PRICE_ID=price_test_basic_monthly_replace_me

# Source: Stripe Dashboard test mode > Products > Pro monthly price ID. Public: no, server-only. Required: yes for Pro checkout.
STRIPE_PRO_PRICE_ID=price_test_pro_monthly_replace_me

# ----------------------------------------------------------------------
# Web Push (VAPID)
# ----------------------------------------------------------------------
# Source: `npx web-push generate-vapid-keys`. Public: yes. Required: yes for browser push subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Source: `npx web-push generate-vapid-keys`. Public: no, server-only. Required: yes for sending Web Push messages.
VAPID_PRIVATE_KEY=your-vapid-private-key

# Source: Deployment owner contact URI. Public: no. Required: yes for VAPID, must be mailto: or https:.
VAPID_SUBJECT=mailto:ops@example.com

# Source: Generate with a password manager. Public: no, server-only. Required: yes for Supabase notification webhooks.
PUSH_WEBHOOK_SECRET=replace-with-random-webhook-secret

# ----------------------------------------------------------------------
# Site URL and Pricing Display
# ----------------------------------------------------------------------
# Source: Local dev URL or Vercel deployment URL. Public: yes. Required: yes for checkout success/cancel redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Source: Product pricing decision matching the Stripe test Basic price. Public: yes. Required: yes for subscription display.
NEXT_PUBLIC_BASIC_MONTHLY_EUR=6.99

# Source: Product pricing decision matching the Stripe test Pro price. Public: yes. Required: yes for subscription display.
NEXT_PUBLIC_PRO_MONTHLY_EUR=12.99

# ----------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------
# Source: Sentry project Client Keys (DSN). Public: no in current code path. Required: no; inject via Vercel env and never hardcode.
SENTRY_DSN=

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------
# Source: Next.js/Vercel runtime. Public: no. Required: yes; Vercel sets this automatically for deployments.
NODE_ENV=development
